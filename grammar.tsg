// Agda grammar for tree-sitter (native DSL).
// Translated from grammar.js.

let INTEGER: rule_t = regexp(r"\-?(0x[0-9a-fA-F]+|[0-9]+)")

// JS helpers translated as macros. The JS variants are variadic with `...rules`;
// here each is single-arg, callers wrap with seq(...) when they need more.

macro sep_r(sep: rule_t, rule: rule_t) rule_t {
    seq(rule, repeat(seq(sep, rule)))
}

macro indent(rule: rule_t) rule_t {
    seq(_indent, rule, _dedent)
}

// `block($, rule)`: indented, 1 or more `rule`s each ending in newline.
macro block(rule: rule_t) rule_t {
    indent(repeat1(seq(rule, _newline)))
}

macro maybe_dotted(rule: rule_t) rule_t {
    choice(rule, seq(".", rule), seq("..", rule))
}

macro paren(rule: rule_t) rule_t {
    seq("(", rule, ")")
}

macro brace(rule: rule_t) rule_t {
    seq("{", rule, "}")
}

// BRACE2 = [['{{', '}}'], ['⦃', '⦄']]
macro brace_double(rule: rule_t) rule_t {
    choice(seq("{{", rule, "}}"), seq("⦃", rule, "⦄"))
}

// IDIOM = [['(|', '|)'], ['⦇', '⦈']]
macro idiom(rule: rule_t) rule_t {
    choice(seq("(|", rule, "|)"), seq("⦇", rule, "⦈"))
}

grammar {
    language: "agda",
    word: id,
    extras: [comment, pragma, regexp(r"\s|\\n")],
    externals: [_newline, _indent, _dedent],
}

rule source_file { repeat(seq(_declaration, _newline)) }

// Constants
rule _FORALL { choice("forall", "∀") }
rule _ARROW { choice("->", "→") }
rule _LAMBDA { choice("\\", "λ") }
rule _ELLIPSIS { choice("...", "…") }

// ---------------------------------------------------------------------------
// Top-level declarations
// ---------------------------------------------------------------------------

rule _declaration_block { block(_declaration) }

rule _declaration {
    choice(
        fields,
        function,
        data,
        data_signature,
        record,
        record_signature,
        infix,
        generalize,
        mutual,
        abstract,
        private,
        instance,
        macro,
        postulate,
        primitive,
        open,
        import,
        module_macro,
        module,
        pragma,
        syntax,
        pattern,
        unquote_decl,
    )
}

// ---------------------------------------------------------------------------
// Field
// ---------------------------------------------------------------------------

rule fields { seq("field", _signature_block) }

rule _signature_block { block(signature) }

rule signature {
    choice(
        seq(optional("overlap"), _modal_arg_ids, ":", expr),
        seq("instance", _signature_block),
    )
}

rule _modal_arg_ids { seq(repeat(attribute), _arg_ids) }

// ---------------------------------------------------------------------------
// Function
// ---------------------------------------------------------------------------

rule function {
    choice(
        seq(
            optional(attributes),
            alias(lhs_decl, lhs),
            alias(optional(rhs_decl), rhs),
            optional(where),
        ),
        seq(
            optional(attributes),
            alias(lhs_defn, lhs),
            alias(optional(rhs_defn), rhs),
            optional(where),
        ),
    )
}

rule lhs_decl {
    seq(
        alias(_with_exprs, function_name),
        optional(rewrite_equations),
        optional(with_expressions),
    )
}

rule lhs_defn {
    prec(1, seq(_with_exprs, optional(rewrite_equations), optional(with_expressions)))
}

rule rhs_decl { seq(":", expr) }
rule rhs_defn { seq("=", expr) }

rule with_expressions { seq("with", expr) }

rule rewrite_equations { seq("rewrite", _with_exprs) }

rule where {
    seq(
        optional(seq("module", bid)),
        "where",
        optional(_declaration_block),
    )
}

// ---------------------------------------------------------------------------
// Data / Record
// ---------------------------------------------------------------------------

rule data_name { alias(id, "data_name") }

rule data {
    seq(
        choice("data", "codata"),
        data_name,
        optional(_typed_untyped_bindings),
        optional(seq(":", expr)),
        "where",
        optional(_declaration_block),
    )
}

rule data_signature {
    seq(
        "data",
        data_name,
        optional(_typed_untyped_bindings),
        ":",
        expr,
    )
}

rule record {
    seq(
        "record",
        alias(_atom_no_curly, record_name),
        optional(_typed_untyped_bindings),
        optional(seq(":", expr)),
        record_declarations_block,
    )
}

rule record_declarations_block {
    seq(
        "where",
        indent(seq(
            repeat(seq(_record_directive, _newline)),
            repeat(seq(_declaration, _newline)),
        )),
    )
}

rule _record_directive {
    choice(record_constructor, record_constructor_instance, record_induction, record_eta)
}

rule record_constructor { seq("constructor", id) }

rule record_constructor_instance {
    seq("instance", block(record_constructor))
}

rule record_induction { choice("inductive", "coinductive") }

rule record_eta { choice("eta-equality", "no-eta-equality") }

rule record_signature {
    seq(
        "record",
        alias(_atom_no_curly, record_name),
        optional(_typed_untyped_bindings),
        ":",
        expr,
    )
}

// ---------------------------------------------------------------------------
// Infix / Generalize / Block declarations
// ---------------------------------------------------------------------------

rule infix {
    seq(choice("infix", "infixl", "infixr"), integer, repeat1(bid))
}

rule generalize { seq("variable", optional(_signature_block)) }

rule mutual { seq("mutual", optional(_declaration_block)) }
rule abstract { seq("abstract", optional(_declaration_block)) }
rule private { seq("private", optional(_declaration_block)) }
rule instance { seq("instance", optional(_declaration_block)) }
rule macro { seq("macro", optional(_declaration_block)) }
rule postulate { seq("postulate", optional(_declaration_block)) }
rule primitive { seq("primitive", optional(_type_signature_block)) }

rule _type_signature_block { block(type_signature) }

rule type_signature { seq(_field_names, ":", expr) }

// ---------------------------------------------------------------------------
// Open / Import
// ---------------------------------------------------------------------------

rule open {
    seq(
        "open",
        choice(import, module_name),
        optional(_atoms),
        optional(_import_directives),
    )
}

rule import { seq("import", module_name) }

rule module_name { _qid }

rule _import_directives { repeat1(import_directive) }

rule import_directive {
    choice(
        "public",
        seq("using", "(", _comma_import_names, ")"),
        seq("hiding", "(", _comma_import_names, ")"),
        seq("renaming", "(", sep_r(";", renaming), ")"),
        seq("using", "(", ")"),
        seq("hiding", "(", ")"),
        seq("renaming", "(", ")"),
    )
}

rule _comma_import_names { sep_r(";", _import_name) }

rule renaming { seq(optional("module"), id, "to", id) }

rule _import_name { seq(optional("module"), id) }

// ---------------------------------------------------------------------------
// Module Macro / Module
// ---------------------------------------------------------------------------

rule module_macro {
    seq(
        choice(
            seq("module", alias(_qid, module_name)),
            seq("open", "module", alias(_qid, module_name)),
        ),
        optional(_typed_untyped_bindings),
        "=",
        module_application,
        repeat(import_directive),
    )
}

rule module_application {
    seq(
        module_name,
        choice(prec(1, brace_double(_ELLIPSIS)), optional(_atoms)),
    )
}

rule module {
    seq(
        "module",
        alias(choice(_qid, "_"), module_name),
        optional(_typed_untyped_bindings),
        "where",
        optional(_declaration_block),
    )
}

// ---------------------------------------------------------------------------
// Pragma
// ---------------------------------------------------------------------------

rule pragma {
    token(seq(
        "{-#",
        repeat(choice(
            regexp(r"[^#]"),
            regexp(r"#[^-]"),
            regexp(r"#\-[^}]"),
        )),
        "#-}",
    ))
}

rule catchall_pragma { seq("{-#", "CATCHALL", "#-}") }

// ---------------------------------------------------------------------------
// Syntax / Pattern / Unquote
// ---------------------------------------------------------------------------

rule syntax { seq("syntax", id, hole_names, "=", repeat1(id)) }

rule hole_names { repeat1(hole_name) }

rule hole_name {
    choice(
        _simple_top_hole,
        brace(_simple_hole),
        brace_double(_simple_hole),
        brace(seq(id, "=", _simple_hole)),
        brace_double(seq(id, "=", _simple_hole)),
    )
}

rule _simple_top_hole {
    choice(id, paren(seq(_LAMBDA, bid, _ARROW, id)))
}

rule _simple_hole {
    choice(id, seq(_LAMBDA, bid, _ARROW, id))
}

rule pattern {
    seq("pattern", id, optional(_lambda_bindings), "=", expr)
}

rule unquote_decl {
    choice(
        seq("unquoteDecl", "=", expr),
        seq("unquoteDecl", _ids, "=", expr),
        seq("unquoteDef", _ids, "=", expr),
    )
}

// ---------------------------------------------------------------------------
// Names
// ---------------------------------------------------------------------------

rule id { regexp(r#"([^\s\\.\"\(\)\{\}@\'\\_]|\\[^\sa-zA-Z]|_[^\s;\.\"\(\)\{\}@])[^\s;\.\"\(\)\{\}@]*"#) }

rule _qid {
    prec_left(0, choice(
        alias(regexp(r#"(([^\s;\.\"\(\)\{\}@\'\\_]|\\[^\sa-zA-Z]|_[^\s;\.\"\(\)\{\}@])[^\s;\.\"\(\)\{\}@]*\.)*([^\s;\.\"\(\)\{\}@\'\\_]|\\[^\sa-zA-Z]|_[^\s;\.\"\(\)\{\}@])[^\s;\.\"\(\)\{\}@]*"#), qid),
        alias(id, qid),
    ))
}

rule bid { alias(choice("_", id), "bid") }

rule _ids { repeat1(id) }

rule _field_name { alias(id, field_name) }
rule _field_names { repeat1(_field_name) }

rule _maybe_dotted_id { maybe_dotted(_field_name) }
rule _maybe_dotted_ids { repeat1(_maybe_dotted_id) }

rule _arg_ids { repeat1(_arg_id) }

rule _arg_id {
    choice(
        _maybe_dotted_id,
        brace(_maybe_dotted_ids),
        brace_double(_maybe_dotted_ids),
        seq(".", brace(_field_names)),
        seq(".", brace_double(_field_names)),
        seq("..", brace(_field_names)),
        seq("..", brace_double(_field_names)),
    )
}

rule _binding_ids_and_absurds {
    prec(-1, choice(
        _application,
        seq(_qid, "=", _qid),
        seq(_qid, "=", "_"),
        seq("-", "=", _qid),
        seq("-", "=", "_"),
    ))
}

rule attribute { seq("@", _expr_or_attr) }
rule attributes { repeat1(attribute) }

// ---------------------------------------------------------------------------
// Expressions
// ---------------------------------------------------------------------------

rule expr {
    choice(
        seq(_typed_bindings, _ARROW, expr),
        seq(optional(attributes), _atoms, _ARROW, expr),
        seq(_with_exprs, "=", expr),
        prec(-1, _with_exprs),
    )
}

rule stmt {
    choice(
        seq(_typed_bindings, _ARROW, expr),
        seq(optional(attributes), _atoms, _ARROW, expr),
        seq(_with_exprs, "=", expr),
        prec(-1, _with_exprs_stmt),
    )
}

rule _with_exprs {
    seq(repeat(seq(_atoms, "|")), _application)
}

rule _with_exprs_stmt {
    seq(repeat(seq(_atoms, "|")), _application_stmt)
}

rule _expr_or_attr { choice(literal, _qid, paren(expr)) }

rule _application { seq(optional(_atoms), _expr2) }
rule _application_stmt { seq(optional(_atoms), _expr2_stmt) }

rule _expr2_without_let {
    choice(
        lambda,
        alias(lambda_extended_or_absurd, lambda),
        forall,
        do,
        prec(-1, atom),
        seq("quoteGoal", id, "in", expr),
        seq("tactic", _atoms),
        seq("tactic", _atoms, "|", _with_exprs),
    )
}

rule _expr2 { choice(_expr2_without_let, let) }

rule _expr2_stmt {
    choice(_expr2_without_let, alias(let_in_do, let))
}

rule atom { choice(_atom_curly, _atom_no_curly) }

rule _atoms { repeat1(atom) }

rule _atom_curly { brace(optional(expr)) }

rule _atom_no_curly {
    choice(
        "_", "Prop", SetN,
        "quote", "quoteTerm", "quoteContext", "unquote",
        PropN,
        brace_double(expr),
        idiom(expr),
        seq("(", ")"),
        seq("{{", "}}"),
        seq("⦃", "⦄"),
        seq(id, "@", atom),
        seq(".", atom),
        record_assignments,
        alias(field_assignments, record_assignments),
        _ELLIPSIS,
        _expr_or_attr,
    )
}

rule forall {
    seq(_FORALL, _typed_untyped_bindings, _ARROW, expr)
}

rule let {
    prec_right(0, seq(
        "let",
        optional(_indent),
        repeat(seq(_declaration, _newline)),
        _declaration,
        optional(_newline),
        _let_body,
    ))
}

rule let_in_do {
    prec_right(0, seq(
        "let",
        optional(_indent),
        repeat(seq(_declaration, _newline)),
        _declaration,
        choice(
            seq(_newline, _dedent),
            seq(_newline, _let_body),
            _let_body,
        ),
    ))
}

rule _let_body { seq("in", expr) }

rule lambda {
    seq(_LAMBDA, _lambda_bindings, _ARROW, expr)
}

rule _lambda_bindings {
    seq(
        repeat(_typed_untyped_binding),
        choice(
            _typed_untyped_binding,
            seq("(", ")"),
            seq("{", "}"),
            seq("{{", "}}"),
            seq("⦃", "⦄"),
        ),
    )
}

rule lambda_extended_or_absurd {
    seq(
        _LAMBDA,
        choice(
            brace(lambda_clause),
            brace(_lambda_clauses),
            seq("where", _lambda_clauses),
            _lambda_bindings,
        ),
    )
}

rule _lambda_clauses {
    prec_left(0, seq(
        repeat(seq(_lambda_clause_maybe_absurd, ";")),
        _lambda_clause_maybe_absurd,
    ))
}

rule _lambda_clause_maybe_absurd {
    prec_left(0, choice(lambda_clause_absurd, lambda_clause))
}

rule lambda_clause_absurd {
    seq(optional(catchall_pragma), _application)
}

rule lambda_clause {
    seq(
        optional(catchall_pragma),
        optional(_atoms),
        _ARROW,
        expr,
    )
}

rule do { seq("do", block(_do_stmt)) }

rule _do_stmt { seq(stmt, optional(do_where)) }

rule do_where { seq("where", _lambda_clauses) }

rule record_assignments {
    seq("record", brace(optional(_record_assignments)))
}

rule field_assignments {
    seq("record", _atom_no_curly, brace(optional(_field_assignments)))
}

rule _record_assignments {
    seq(repeat(seq(_record_assignment, ";")), _record_assignment)
}

rule _field_assignments {
    seq(repeat(seq(field_assignment, ";")), field_assignment)
}

rule _record_assignment { choice(field_assignment, module_assignment) }

rule field_assignment {
    seq(alias(id, field_name), "=", expr)
}

rule module_assignment {
    seq(module_name, optional(_atoms), optional(_import_directives))
}

// ---------------------------------------------------------------------------
// Bindings
// ---------------------------------------------------------------------------

rule _typed_bindings { repeat1(typed_binding) }

rule typed_binding {
    choice(
        maybe_dotted(choice(
            paren(seq(_application, ":", expr)),
            brace(seq(_binding_ids_and_absurds, ":", expr)),
            brace_double(seq(_binding_ids_and_absurds, ":", expr)),
        )),
        paren(seq(attributes, _application, ":", expr)),
        brace(seq(attributes, _binding_ids_and_absurds, ":", expr)),
        brace_double(seq(attributes, _binding_ids_and_absurds, ":", expr)),
        paren(open),
        paren(seq("let", _declaration_block)),
    )
}

rule _typed_untyped_bindings { repeat1(_typed_untyped_binding) }

rule _typed_untyped_binding { choice(untyped_binding, typed_binding) }

rule untyped_binding {
    choice(
        maybe_dotted(choice(
            bid,
            brace(_binding_ids_and_absurds),
            brace_double(_binding_ids_and_absurds),
        )),
        paren(_binding_ids_and_absurds),
        paren(seq(attributes, _binding_ids_and_absurds)),
        brace(seq(attributes, _binding_ids_and_absurds)),
        brace_double(seq(attributes, _binding_ids_and_absurds)),
    )
}

// ---------------------------------------------------------------------------
// Literals / Comments / Set
// ---------------------------------------------------------------------------

rule integer { INTEGER }
rule string { regexp(r#"\".*\""#) }
rule literal { choice(INTEGER, regexp(r#"\".*\""#)) }

rule comment {
    token(choice(
        prec(100, seq("--", regexp(r".*"))),
        seq("{--}"),
        seq(
            "{-",
            regexp(r"[^#]"),
            repeat(choice(
                regexp(r"[^-]"),
                regexp(r"-[^}]"),
            )),
            regexp(r"-}"),
        ),
    ))
}

rule SetN { prec_right(2, seq("Set", optional(atom))) }

rule PropN { "propN" }
